{
  "manifest_version": 3,
  "name": "사이쿄",
  "version": "1.1.0",
  "description": "서울대학교 수강신청을 도와드리밍",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "incognito": "not_allowed",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    },
    "default_title": "사이쿄"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.sugang.snu.ac.kr/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.sugang.snu.ac.kr/*"
      ],
      "js": [
        "src/main.tsx"
      ],
      "run_at": "document_end"
    }
  ],
  "key": "",
  "background": {
    "service_worker": "src/core/background.ts",
    "type": "module"
  }
}
